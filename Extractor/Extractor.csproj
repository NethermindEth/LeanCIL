<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Read before this file sets the framework, so only a per-framework inner build sees one. -->
    <PerFrameworkBuild Condition="'$(TargetFramework)' != ''">true</PerFrameworkBuild>
    <OutputType>Exe</OutputType>
    <AssemblyName>Nethermind.LeanCIL</AssemblyName>
    <RootNamespace>Nethermind.LeanCIL</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>leancil</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Verification/Verification.cs declares the file-based script includes for test callers. -->
    <Features>$(Features);FileBasedProgram</Features>
    <StartupObject>Nethermind.LeanCIL.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeanCIL.IdentityTests" />
    <PackageReference Include="Mono.Cecil" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-MIT" Pack="true" PackagePath="/" />
    <Compile Include="../scripts/Verification/ToolHost.cs" Link="Verification/ToolHost.cs" />
    <Compile Include="../scripts/Verification/ProcessAndPaths.cs" Link="Verification/ProcessAndPaths.cs" />
    <Compile Include="../scripts/Verification/LibraryCache.cs" Link="Verification/LibraryCache.cs" />
    <Compile Include="../scripts/Verification/ReplayAndAudit.cs" Link="Verification/ReplayAndAudit.cs" />
    <Compile Include="../scripts/Verification/ProofExecution.cs" Link="Verification/ProofExecution.cs" />
    <Compile Include="../scripts/Consumer/Fingerprints.cs" Link="Consumer/Fingerprints.cs" />
    <Compile Include="../scripts/Consumer/WorkspaceAndComponents.cs" Link="Consumer/WorkspaceAndComponents.cs" />
    <Compile Include="../scripts/Consumer/Orchestration.cs" Link="Consumer/Orchestration.cs" />
    <Compile Include="../scripts/Consumer/ProofWorkspace.cs" Link="Consumer/ProofWorkspace.cs" />
    <Compile Include="../scripts/Consumer/ProofWatch.cs" Link="Consumer/ProofWatch.cs" />
    <Compile Include="../scripts/Consumer/ContractExport.cs" Link="Consumer/ContractExport.cs" />
    <Compile Include="../scripts/Consumer/FullImportVerification.cs" Link="Consumer/FullImportVerification.cs" />
    <Compile Include="../scripts/Consumer/FullModuleResolution.cs" Link="Consumer/FullModuleResolution.cs" />
    <Compile Include="../scripts/Checking/LeanDiagnostics.cs" Link="Checking/LeanDiagnostics.cs" />
    <Compile Include="../scripts/Checking/FailureReports.cs" Link="Checking/FailureReports.cs" />
    <Compile Include="../scripts/Checking/VerifyReports.cs" Link="Checking/VerifyReports.cs" />
    <Compile Include="../scripts/Checking/LibraryAudit.cs" Link="Checking/LibraryAudit.cs" />
    <Compile Include="../scripts/Checking/DeepChecks.cs" Link="Checking/DeepChecks.cs" />
    <Compile Include="../scripts/Checking/DeepCheckInputs.cs" Link="Checking/DeepCheckInputs.cs" />
    <Compile Include="../scripts/Checking/BindingImage.cs" Link="Checking/BindingImage.cs" />
    <Content Include="../CIL/**/*.lean;../CIL.lean;../StrictBinding/**/*.lean;../StrictBinding.lean;../lakefile.toml;../lake-manifest.json;../lean-toolchain">
      <Link>verification/%(Identity)</Link>
      <TargetPath>verification/$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/..', '%(FullPath)'))</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <!-- A development package gets a fresh prerelease version, so a tool install never reuses a cached
       package of the same version; only a release pack, given its descriptors, is the plain version.
       The pack's per-framework inner build, which builds the shipped assembly, reuses its version. -->
  <PropertyGroup Condition="'$(CertifiedLibraryReleaseDirectory)' == '' and '$(PackageVersion)' == ''">
    <DevPackageVersionFile
      >$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'dev-package-version.txt'))</DevPackageVersionFile>
    <PackageVersion Condition="'$(PerFrameworkBuild)' == 'true' and Exists('$(DevPackageVersionFile)')"
      >$([System.IO.File]::ReadAllText('$(DevPackageVersionFile)').Trim())</PackageVersion>
    <DevPackageVersionStamped Condition="'$(PackageVersion)' == ''">true</DevPackageVersionStamped>
    <PackageVersion Condition="'$(PackageVersion)' == ''"
      >$(VersionPrefix)-dev.$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</PackageVersion>
  </PropertyGroup>

  <!-- A packed tool reports the version it is installed as; other builds keep their assembly info stable. -->
  <PropertyGroup Condition="'$(_IsPacking)' == 'true' and '$(InformationalVersion)' == ''">
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="ShareDevPackageVersion" BeforeTargets="_WalkEachTargetPerFramework"
          Condition="'$(DevPackageVersionStamped)' == 'true'">
    <WriteLinesToFile File="$(DevPackageVersionFile)" Lines="$(PackageVersion)" Overwrite="true" />
  </Target>

  <!-- A version left from an earlier pack must never name a later one. -->
  <Target Name="ForgetDevPackageVersion" AfterTargets="Pack" Condition="'$(DevPackageVersionStamped)' == 'true'">
    <Delete Files="$(DevPackageVersionFile)" />
  </Target>

  <!-- Release descriptors are generated from authenticated, replayed artifacts by the publisher. -->
  <ItemGroup Condition="'$(CertifiedLibraryReleaseDirectory)' != ''">
    <Content Include="$(CertifiedLibraryReleaseDirectory)/certified-library-release.*.json">
      <Link>verification/%(Filename)%(Extension)</Link>
      <TargetPath>verification/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <!-- A published verifier must contain the selected proof sources even if a previous output
       has the same length and modification time. The SDK normally skips copies in that case. -->
  <Target Name="CopyPublishedVerifierInputsExactly" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <SkipCopyUnchangedFiles>false</SkipCopyUnchangedFiles>
    </PropertyGroup>
  </Target>
  <!-- Keep the managed assembly identity while giving the CLI a short executable name. -->
  <Target Name="NameCliExecutable" AfterTargets="_ComputeNETCoreBuildOutputFiles">
    <ItemGroup>
      <None Update="$(AppHostIntermediatePath)" Condition="'$(AppHostIntermediatePath)' != ''">
        <Link>leancil$(_NativeExecutableExtension)</Link>
        <TargetPath>leancil$(_NativeExecutableExtension)</TargetPath>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="SetCliRunCommand" BeforeTargets="ComputeRunArguments" Condition="'$(UseAppHost)' == 'true'">
    <PropertyGroup>
      <RunCommand>$(TargetDir)leancil$(_NativeExecutableExtension)</RunCommand>
    </PropertyGroup>
  </Target>

</Project>
