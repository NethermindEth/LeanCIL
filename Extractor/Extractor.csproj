<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Read before this file sets the framework, so only a per-framework inner build sees one. -->
    <PerFrameworkBuild Condition="'$(TargetFramework)' != ''">true</PerFrameworkBuild>
    <OutputType>Exe</OutputType>
    <AssemblyName>Nethermind.LeanCIL</AssemblyName>
    <RootNamespace>Nethermind.LeanCIL</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>leancil</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LEANCIL_TOOL</DefineConstants>
    <StartupObject>Nethermind.LeanCIL.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-MIT" Pack="true" PackagePath="/" />
    <Compile Include="../scripts/Verification.cs" Link="Verification.cs" />
    <Compile Include="../scripts/ConsumerVerification.cs" Link="ConsumerVerification.cs" />
    <Compile Include="../scripts/ProofWorkspace.cs" Link="ProofWorkspace.cs" />
    <Compile Include="../scripts/ProofWatch.cs" Link="ProofWatch.cs" />
    <Compile Include="../scripts/ContractExport.cs" Link="ContractExport.cs" />
    <Compile Include="../scripts/FullImportVerification.cs" Link="FullImportVerification.cs" />
    <Compile Include="../scripts/FullModuleResolution.cs" Link="FullModuleResolution.cs" />
    <Compile Include="../scripts/LeanDiagnostics.cs" Link="LeanDiagnostics.cs" />
    <Compile Include="../scripts/FailureReports.cs" Link="FailureReports.cs" />
    <Compile Include="../scripts/VerifyReports.cs" Link="VerifyReports.cs" />
    <Compile Include="../scripts/LibraryAudit.cs" Link="LibraryAudit.cs" />
    <Compile Include="../scripts/ProofBindingCatalog.cs" Link="ProofBindingCatalog.cs" />
    <Content Include="../CIL/**/*.lean;../CIL.lean;../lakefile.toml;../lake-manifest.json;../lean-toolchain">
      <Link>verification/%(Identity)</Link>
      <TargetPath>verification/$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/..', '%(FullPath)'))</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <!-- A development package gets a fresh prerelease version, so a tool install never reuses a cached
       package of the same version; only a release pack, given its descriptors, is the plain version.
       The pack's per-framework inner build, which builds the shipped assembly, reuses its version. -->
  <PropertyGroup Condition="'$(CertifiedLibraryReleaseDirectory)' == '' and '$(PackageVersion)' == ''">
    <DevPackageVersionFile
      >$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'dev-package-version.txt'))</DevPackageVersionFile>
    <PackageVersion Condition="'$(PerFrameworkBuild)' == 'true' and Exists('$(DevPackageVersionFile)')"
      >$([System.IO.File]::ReadAllText('$(DevPackageVersionFile)').Trim())</PackageVersion>
    <DevPackageVersionStamped Condition="'$(PackageVersion)' == ''">true</DevPackageVersionStamped>
    <PackageVersion Condition="'$(PackageVersion)' == ''"
      >$(VersionPrefix)-dev.$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</PackageVersion>
  </PropertyGroup>

  <!-- A packed tool reports the version it is installed as; other builds keep their assembly info stable. -->
  <PropertyGroup Condition="'$(_IsPacking)' == 'true' and '$(InformationalVersion)' == ''">
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="ShareDevPackageVersion" BeforeTargets="_WalkEachTargetPerFramework"
          Condition="'$(DevPackageVersionStamped)' == 'true'">
    <WriteLinesToFile File="$(DevPackageVersionFile)" Lines="$(PackageVersion)" Overwrite="true" />
  </Target>

  <!-- A version left from an earlier pack must never name a later one. -->
  <Target Name="ForgetDevPackageVersion" AfterTargets="Pack" Condition="'$(DevPackageVersionStamped)' == 'true'">
    <Delete Files="$(DevPackageVersionFile)" />
  </Target>

  <!-- Release descriptors are generated from authenticated, replayed artifacts by the publisher. -->
  <ItemGroup Condition="'$(CertifiedLibraryReleaseDirectory)' != ''">
    <Content Include="$(CertifiedLibraryReleaseDirectory)/certified-library-release.*.json">
      <Link>verification/%(Filename)%(Extension)</Link>
      <TargetPath>verification/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <!-- Keep the managed assembly identity while giving the CLI a short executable name. -->
  <Target Name="NameCliExecutable" AfterTargets="_ComputeNETCoreBuildOutputFiles">
    <ItemGroup>
      <None Update="$(AppHostIntermediatePath)" Condition="'$(AppHostIntermediatePath)' != ''">
        <Link>leancil$(_NativeExecutableExtension)</Link>
        <TargetPath>leancil$(_NativeExecutableExtension)</TargetPath>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="SetCliRunCommand" BeforeTargets="ComputeRunArguments" Condition="'$(UseAppHost)' == 'true'">
    <PropertyGroup>
      <RunCommand>$(TargetDir)leancil$(_NativeExecutableExtension)</RunCommand>
    </PropertyGroup>
  </Target>

</Project>
