open CIL.Safety Tests.HalfSwapContract
namespace VariantProof

def witnessByte : Prop := ∃ fuel,
  (invoke Extracted.program fuel 0 (swap.args witness) (memory witness)).map
    (fun result => (result.1.cells 0 0).bits) = .ok 1

theorem directWitnessByte : witnessByte := ⟨19, by with_unfolding_all rfl⟩
#print axioms directWitnessByte

theorem sharedWitnessByte : witnessByte := by
  obtain ⟨fuel, ⟨after, values⟩, ran, _, _, _, post⟩ :=
    correctness witness (memory witness) rfl
  have first : (after.cells 0 0).bits = 1 := post 0 (by decide)
  refine ⟨fuel, ?_⟩
  change invoke Extracted.program fuel 0 (swap.args witness) (memory witness) = .ok (after, values) at ran
  rw [ran]
  exact congrArg Except.ok first
#print axioms sharedWitnessByte
end VariantProof
