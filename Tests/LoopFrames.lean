import CIL.MethodIdentity
import CIL.Safety.LoopScaffold
import CIL.Safety.LoopVC

/-!
# Loop frame tests

The frame facts of a one-local loop frame survive a write to the caller's buffer and a call
confined to it, and the local still loads. A store through the local's own address, and a callee
whose footprint covers that home, are both rejected by the frame lemmas: each needs the write
in caller storage. Such a write can change the local, so the rejection is required: after it
the remembered value no longer holds. A frame of two locals generated by `bind_entry` keeps
the first local across a store to the second, and rejects a write through the second's home.
A loop over a `bind_method` body enters, cuts and returns as one over the extracted literal. A
generated frame that mixes a home with a span parameter follows the frame's local indices, so the
`frame.locals` lemmas store and load its home, while its span local loads as no home. Facts
at the caller's memory that read only allocations hold at every frame memory, a slice of a span
apart from an entry stays apart, and a stored word extends a filled run only right after it.
-/

namespace Tests.LoopFrames

open CIL.Safety

variable {caller current after : Memory} {base home : Reference}

/-- The frame of a loop whose index local holds 5, over a caller buffer and the index home. -/
abbrev Indexed (caller current : Memory) (base home : Reference) : Prop :=
  LoopFrame [(base, 8 * 1), (home, 4)] caller current [.word32] [.bytes .word32 home]
    (knownLocals [some (.i32 5)])

/-- A write of the caller's buffer keeps the frame, and the index still loads as 5. -/
theorem buffer_write_kept (frame : Indexed caller current base home)
    (old : base.allocation < caller.nextIdentity) {word : BitVec 64}
    (written : write current (base.element 8 0) (numberBytes word.toNat 8) 1 = .ok after) :
    loadLocal after (.bytes .word32 home) = .ok (.scalar (.i32 5)) :=
  (frame.write_element written (List.mem_cons_self ..) (by decide) old).load 0

/-- Writing 6 over a home remembered as holding 5 breaks its snapshot. -/
theorem overwritten_forgets
    (written : write current home (numberBytes 6 4) 1 = .ok after) :
    ¬ LocalSnapshots after [.bytes .word32 home] (knownLocals [some (.i32 5)]) := by
  intro kept
  obtain ⟨kind, reference, stored, number, slot, fits, result, loaded⟩ := kept 0 _ rfl
  simp only [List.getElem?_cons_zero, Option.some.injEq, LocalSlot.bytes.injEq] at slot
  obtain ⟨rfl, rfl⟩ := slot
  have readback := write_readback _ _ _ _ _ written
  simp only [numberBytes_length, localWidth] at readback loaded
  rw [readback] at loaded
  cases stored <;> simp [localResult, localNumber, CIL.Value.hasUnspecified] at fits result
  subst result
  subst fits
  revert loaded
  simp only [Except.ok.injEq, BitVec.toNat_ofNat]
  decide

/-- A store through the index local's address is in the footprint, but the write lemma needs
    the target in caller storage, which the home is not, while the same lemma takes a store into
    the buffer; the home store does break the index. -/
theorem home_write_rejected {stored : Memory} (frame : Indexed caller current base home)
    (old : base.allocation < caller.nextIdentity)
    (buffered : write current base (numberBytes 7 4) 1 = .ok stored)
    (written : write current home (numberBytes 6 4) 1 = .ok after) :
    Indexed caller stored base home ∧
      ¬ LocalSnapshots after [.bytes .word32 home] (knownLocals [some (.i32 5)]) := by
  fail_if_success
    have := frame.write written ⟨_, List.mem_cons_of_mem _ (List.mem_singleton_self _),
      by simp [Within, numberBytes_length]⟩ (by have := frame.homes.home_bound 0 _ _ rfl; omega)
  exact ⟨frame.write buffered
      ⟨_, List.mem_cons_self .., by simp [Within, numberBytes_length]⟩ old,
    overwritten_forgets written⟩

/-- A call confined to the caller's buffer keeps the frame, and the index still loads as 5. -/
theorem buffer_call_kept (frame : Indexed caller current base home)
    (old : base.allocation < caller.nextIdentity)
    (called : Confined [(base, 8 * 1)] current after) (formed : after.WellFormed) :
    loadLocal after (.bytes .word32 home) = .ok (.scalar (.i32 5)) :=
  (frame.after_confined called formed
    (fun entry member => ⟨entry, by simp_all, by simp_all [Within]⟩)
    (fun entry member => by simp_all)).load 0

/-- A callee whose footprint covers the index home may change it, as this store does; the call
    lemma needs every callee entry in caller storage, so it does not apply, while it takes a
    callee confined to the buffer. -/
theorem home_call_rejected {returned : Memory} (frame : Indexed caller current base home)
    (old : base.allocation < caller.nextIdentity)
    (bufferCall : Confined [(base, 8 * 1)] current returned)
    (returnedFormed : returned.WellFormed)
    (written : write current home (numberBytes 6 4) 1 = .ok after) :
    Indexed caller returned base home ∧
      ¬ LocalSnapshots after [.bytes .word32 home] (knownLocals [some (.i32 5)]) := by
  have called : Confined [(home, 4)] current after :=
    Confined.write written (by simp [numberBytes_length])
  have formed := write_preserves_wellFormed _ _ _ _ _ frame.wellFormed written
  fail_if_success
    have := frame.after_confined called formed
      (fun entry member => ⟨entry, by simp_all, by simp_all [Within]⟩)
      (fun entry member => by
        have := frame.homes.home_bound 0 _ _ rfl
        simp_all
        omega)
  exact ⟨frame.after_confined bufferCall returnedFormed
      (fun entry member => ⟨entry, by simp_all, by simp_all [Within]⟩)
      (fun entry member => by simp_all),
    overwritten_forgets written⟩

#print axioms buffer_write_kept
#print axioms overwritten_forgets
#print axioms home_write_rejected
#print axioms buffer_call_kept
#print axioms home_call_rejected

end Tests.LoopFrames

namespace Tests.LoopFrames.TwoLocals
open CIL.Safety

/-- A method with a word local holding 7 and an int local holding 5. -/
def body : CIL.Method := {
  code := [.ret], locals := [.i64 7, .i32 5], returnsValue := false
  localKinds := [.word64, .word32] }

bind_entry entry (memory : Memory) (wellFormed : memory.WellFormed) := body
  with [] from memory allocating wellFormed

/-- The generated two-local frame: storing 9 into the second local keeps the first at 7. -/
theorem store_second_keeps_first (memory : Memory) (wellFormed : memory.WellFormed) :
    ∃ first second updated : _,
      loadLocal updated (.bytes .word64 first) = .ok (.scalar (.i64 7)) ∧
      loadLocal updated (.bytes .word32 second) = .ok (.scalar (.i32 9)) := by
  obtain ⟨first, second, entered, -, -, -, -, frame⟩ := entry.checked memory wellFormed
  obtain ⟨updated, -, next, -⟩ := (frame []).store 1 (.i32 9) rfl
  exact ⟨first, second, updated, next.load 0, next.load 1⟩

variable {caller current after : Memory} {first second : Reference}

/-- The frame of the two locals, with the second local's home in its footprint. -/
abbrev Pair (caller current : Memory) (first second : Reference) : Prop :=
  LoopFrame [(second, 4)] caller current [.word64, .word32]
    [.bytes .word64 first, .bytes .word32 second] (knownLocals [some (.i64 7), some (.i32 5)])

/-- Writing 6 over the second home breaks the snapshot that remembers it as 5. -/
theorem second_overwritten_forgets
    (written : write current second (numberBytes 6 4) 1 = .ok after) :
    ¬ LocalSnapshots after [.bytes .word64 first, .bytes .word32 second]
      (knownLocals [some (.i64 7), some (.i32 5)]) := by
  intro kept
  obtain ⟨kind, reference, stored, number, slot, fits, result, loaded⟩ := kept 1 _ rfl
  simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq,
    LocalSlot.bytes.injEq] at slot
  obtain ⟨rfl, rfl⟩ := slot
  have readback := write_readback _ _ _ _ _ written
  simp only [numberBytes_length, localWidth] at readback loaded
  rw [readback] at loaded
  cases stored <;> simp [localResult, localNumber, CIL.Value.hasUnspecified] at fits result
  subst result
  subst fits
  revert loaded
  simp only [Except.ok.injEq, BitVec.toNat_ofNat]
  decide

/-- A write through the second local's home is in the footprint, but the write lemma needs it
    in caller storage, so it does not apply; the first local still loads, and the write does
    break the second. -/
theorem second_home_write_rejected (frame : Pair caller current first second)
    (written : write current second (numberBytes 6 4) 1 = .ok after) :
    loadLocal current (.bytes .word64 first) = .ok (.scalar (.i64 7)) ∧
      ¬ LocalSnapshots after [.bytes .word64 first, .bytes .word32 second]
        (knownLocals [some (.i64 7), some (.i32 5)]) := by
  fail_if_success
    have := frame.write written ⟨_, List.mem_singleton_self _,
      by simp [Within, numberBytes_length]⟩ (by have := frame.homes.home_bound 1 _ _ rfl; omega)
  exact ⟨frame.load 0, second_overwritten_forgets written⟩

#print axioms store_second_keeps_first
#print axioms second_overwritten_forgets
#print axioms second_home_write_rejected

end Tests.LoopFrames.TwoLocals

/-! A synthetic extraction: one countdown method, bound by signature rather than by index. -/
namespace Extracted

/-- `while (remaining != 0) remaining--; return remaining;` with `remaining` in a frame home. -/
@[cil_code] def method0 : CIL.Method := {
  locals := [.i32 0], localKinds := [.word32], returnsValue := true
  code := [.arg 0, .setLocal 0, .local 0, .brnonzero 6, .local 0, .ret, .local 0, .const32 1,
    .sub, .setLocal 0, .branch 2] }

/-- The extracted program. -/
@[cil_code] def program : CIL.Program := [method0]

/-- The signature of each extracted method. -/
def signatures : List String := ["System.UInt32 Loops.Count::Down(System.UInt32)"]

end Extracted

namespace Tests.LoopFrames.BoundMethod
open CIL.Safety

bind_method down downBody := "System.UInt32 Loops.Count::Down(System.UInt32)"

-- `downBody` only names `Extracted.method0`, which frame setup must unfold to allocate the home.
bind_entry entry (input : CIL.W32) := downBody with [.scalar (.i32 input)] from Memory.empty
  allocating Memory.empty_wellFormed

-- The only conditional branch, selected by its shape, with the home as a binder.
bind_cutpoint cutpoint (home : Reference) := downBody
  matching (fun op => match op with | .brnonzero _ => true | _ => false) with entry.frame home

/-- The remaining count, held in the frame home, with the frame facts of the current memory. -/
abbrev State (home : Reference) :=
  FrameState [] Memory.empty [.word32] CIL.W32 (fun _ => [.bytes .word32 home])
    fun remaining => [some (.i32 remaining)]

/-- The loop head of `downBody` for a state. -/
def header (home : Reference) (state : State home) : LoopState :=
  cutpoint home [.scalar (.i32 state.values)] state.memory

/-- A loop entered and cut over a `bind_method` body steps as one over the extracted literal:
    every input counts down to zero and keeps the empty caller memory. -/
theorem down_returns_zero (input : CIL.W32) :
    ∃ fuel final, invoke Extracted.program fuel down [.scalar (.i32 input)] Memory.empty =
      .ok (final, [.scalar (.i32 0)]) ∧
        MemoryBelow Memory.empty.nextIdentity Memory.empty final := by
  obtain ⟨home, entered, setup, -, -, entryFrame⟩ := entry.checked input
  obtain ⟨started, stored, frame, -⟩ := (entryFrame []).store 0 (.i32 input) rfl
  refine invoke_loop_results down.found (by rfl) setup (header home) (fun _ => True)
    (·.values.toNat) ⟨input, started, frame⟩ (by cil_loop_steps [header]) trivial ?_
  rintro ⟨remaining, current, frame⟩ -
  by_cases zero : remaining = 0
  · subst zero
    left
    cil_loop_finish [header]
  · obtain ⟨updated, stored, nextFrame, -⟩ := frame.store 0 (.i32 (remaining - 1)) rfl
    cil_loop_continue ⟨remaining - 1, updated, nextFrame⟩ [header, zero]
    · trivial
    · have positive : remaining.toNat ≠ 0 := fun same => zero (BitVec.eq_of_toNat_eq same)
      have one : (1 : CIL.W32).toNat = 1 := rfl
      show (remaining - 1).toNat < remaining.toNat
      rw [BitVec.toNat_sub_of_le (by rw [BitVec.le_def]; omega)]
      omega

#print axioms down_returns_zero

end Tests.LoopFrames.BoundMethod

namespace Tests.LoopFrames.MixedLocals
open CIL.Safety

/-- A method with a word home and a readonly span parameter, which `enterFrame` appends to the
    locals as local 1 without a byte home. -/
def body : CIL.Method := {
  locals := [.i64 0], localKinds := [.word64], returnsValue := true
  parameterHomes := [(0, .span 8 false)], code := [.local 0, .ret] }

bind_entry entry (memory : Memory) (view : SpanView) (wellFormed : memory.WellFormed)
    (valid : view.validate memory = .ok ()) (width : view.width = 8)
    (readOnly : view.writable = false) := body
  with [.bufferSpan view] from memory allocating wellFormed
  simplifying [valid, width, readOnly]

/-- The generated frame follows the frame's local indices: its slots are the entered frame's
    locals, the span included, so `LocalSnapshots.store` and `load` over `frame.locals` apply. -/
theorem store_then_load (memory : Memory) (view : SpanView) (wellFormed : memory.WellFormed)
    (valid : view.validate memory = .ok ()) (width : view.width = 8)
    (readOnly : view.writable = false) {pc : Nat} {args stack : List Value} (word : CIL.W64) :
    ∃ home entered after,
      step body (.setLocal 0) pc args (entry.frame memory view home)
          (.scalar (.i64 word) :: stack) entered =
        .ok (.next (pc + 1) stack (entry.frame memory view home) after) ∧
      step body (.local 0) pc args (entry.frame memory view home) stack after =
        .ok (.next (pc + 1) (.scalar (.i64 word) :: stack) (entry.frame memory view home)
          after) := by
  obtain ⟨home, entered, -, -, -, frame⟩ :=
    entry.checked memory view wellFormed valid width readOnly
  have started := frame []
  obtain ⟨after, stepped, known, -⟩ :=
    started.snapshots.store (frame := entry.frame memory view home) (index := 0) started.homes
      started.wellFormed .word64 home (.i64 word) word.toNat rfl rfl
      (started.homes.writable_at (index := 0) rfl)
  exact ⟨home, entered, after, stepped, known.load (.i64 word) rfl⟩

/-- The span local has no byte home: the frame remembers nothing for it, so it cannot be loaded
    as a home, and a remembered home cannot be replaced by another slot. -/
theorem span_not_home (memory : Memory) (view : SpanView) (wellFormed : memory.WellFormed)
    (valid : view.validate memory = .ok ()) (width : view.width = 8)
    (readOnly : view.writable = false) :
    ∃ home : Reference, ∀ kind reference,
      (entry.frame memory view home).locals[1]? ≠ some (.bytes kind reference) := by
  obtain ⟨home, entered, -, -, -, frame⟩ :=
    entry.checked memory view wellFormed valid width readOnly
  fail_if_success have := (frame []).load 1
  fail_if_success have := (frame []).set_local 0 (.root none)
  exact ⟨home, fun kind reference same => by cases same⟩

#print axioms store_then_load
#print axioms span_not_home

end Tests.LoopFrames.MixedLocals

namespace Tests.LoopFrames.CallerFacts
open CIL.Safety

variable {caller current : Memory} {base home : Reference}

/-- A frame over a caller buffer of four words, with one int local. -/
abbrev Buffered (caller current : Memory) (base home : Reference) : Prop :=
  LoopFrame [(base, 4 * 4)] caller current [.word32] [.bytes .word32 home]
    (knownLocals [some (.i32 5)])

/-- A formed caller reference, its `Unsafe.Add` element and a span's validity, element and slice
    hold at every frame memory, whatever the footprint: each reads only allocations. -/
theorem caller_facts_carried (frame : Buffered caller current base home)
    (formed : caller.WellFormed) (valid : form caller base = .ok base)
    {offset : CIL.W64} {element : Reference} (added : add caller base 4 offset = .ok element)
    {view sliced : SpanView} (checked : view.validate caller = .ok ())
    (cut : view.slice caller 1 2 = .ok sliced) :
    form current base = .ok base ∧ add current base 4 offset = .ok element ∧
      view.validate current = .ok () ∧ view.slice current 1 2 = .ok sliced :=
  ⟨frame.caller_form formed valid, frame.caller_add formed added,
    frame.caller_valid formed checked, frame.caller_slice formed cut⟩

-- A fact about a memory other than the frame's caller is not carried.
/-- error: Application type mismatch -/
#guard_msgs (substring := true) in
example (frame : Buffered caller current base home) {other : Memory}
    (formed : other.WellFormed) (valid : form other base = .ok base) :
    form current base = .ok base :=
  frame.caller_form formed valid

/-- A span apart from an entry keeps every slice of it apart. -/
theorem slice_apart {view sliced : SpanView} {entry : Reference × Nat}
    (apart : SpanApart view entry) (cut : view.slice caller 1 2 = .ok sliced) :
    SpanApart sliced entry :=
  apart.slice cut

/-- One word of a writable run is a writable run of its own, starting at that word, and a run
    outside the original is refused. -/
theorem sub_run (writable : Writable caller base 4 2 3) :
    Writable caller (base.element 4 3) 4 0 1 := by
  fail_if_success exact writable.sub (index := 1) (length := 1) (by omega) (by omega)
  fail_if_success exact writable.sub (index := 4) (length := 2) (by omega) (by omega)
  exact writable.sub (index := 3) (length := 1) (by omega) (by omega)

/-- A word stored right after the filled words extends them. -/
theorem extended {xs : List (BitVec 32)} {x : BitVec 32}
    (filled : Filled caller base 4 xs (2 + 1))
    (slot : Contents caller (base.element 4 xs.length) 4 [x]) :
    Filled caller base 4 (xs ++ [x]) 2 :=
  filled.extend slot rfl

-- A word stored past the next one leaves a gap, so it does not extend them.
/-- error: Application type mismatch: The argument
  rfl
has type
  ?m.46 = ?m.46
but is expected to have type
  xs.length + 1 = xs.length -/
#guard_msgs (substring := true) in
example {xs : List (BitVec 32)} {x : BitVec 32} (filled : Filled caller base 4 xs (2 + 1))
    (elsewhere : Contents caller (base.element 4 (xs.length + 1)) 4 [x]) :
    Filled caller base 4 (xs ++ [x]) 2 :=
  filled.extend elsewhere rfl

-- An eight-byte store is not an int store of 1, 2 or 4 bytes.
/-- error: could not synthesize default value for parameter 'narrow' using tactics -/
#guard_msgs (substring := true) in
example {memory after : Memory} {target : Reference} {bits : CIL.W32}
    (written : write memory target (numberBytes bits.toNat 8) 1 = .ok after) :=
  step_storeScalar_of_write written

/-- info: 'Tests.LoopFrames.CallerFacts.caller_facts_carried' depends on axioms: [propext,
 Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms caller_facts_carried
#print axioms slice_apart
#print axioms sub_run
#print axioms extended

end Tests.LoopFrames.CallerFacts
