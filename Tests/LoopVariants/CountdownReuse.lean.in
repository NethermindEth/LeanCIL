import Proof

namespace CountdownConsumer
open CIL CIL.Safety

/-- The compiled method returns zero on the empty entry memory for this argument. -/
def returnsZero (n : W32) : Prop := ∃ fuel,
    ((invoke Extracted.program fuel 0 [.scalar (.i32 n)] Memory.empty).toOption.map Prod.snd) =
      some [.scalar (.i32 0)]

/-- Use the compiled loop contract's termination witness and returned stack. -/
theorem reuse (n : W32) : returnsZero n := by
  obtain ⟨fuel, final, values, ran, rfl⟩ :=
    ExampleProof.correctness [.scalar (.i32 n)] Memory.empty ⟨n, rfl, rfl⟩
  exact ⟨fuel, by rw [ran]; rfl⟩

set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

theorem direct4 : returnsZero 4 := ⟨64, rfl⟩
theorem reused4 : returnsZero 4 := reuse 4

theorem direct16 : returnsZero 16 := ⟨160, rfl⟩
theorem reused16 : returnsZero 16 := reuse 16
#print axioms direct4
#print axioms reused4
#print axioms direct16
#print axioms reused16
end CountdownConsumer
