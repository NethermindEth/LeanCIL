bind_entry entry (value : W32) := Extracted.method0
  with [.scalar (.i32 value)] from Memory.empty allocating Memory.empty_wellFormed

/-- Subtracting zero leaves the remaining count one on every visit to the guard. -/
theorem correctness : countdownContract.Refuted Extracted.program 0 := by
  apply MethodContract.Refuted.of_diverges (input := 1) (initial := Memory.empty) rfl
  obtain ⟨home, entered, enter⟩ := entry.checked 1
  obtain ⟨started, stored, facts, -⟩ := (enter.frame []).store 0 (.i32 1) rfl
  let frame := entry.frame home
  let atGuard (memory : Memory) : SegmentState := ⟨frame, [], memory⟩
  apply Diverges.of_reaches (pc := 7) (cost := 3) (head := atGuard started)
    Extracted.program_method0 rfl enter.setup
  · apply SegmentRun.reaches
    intro fuel
    dsimp only [atGuard, frame, entry.frame]
    cil_checked_steps [stored] <;> rfl
  let invariant (pc : Nat) (state : SegmentState) := pc = 7 ∧ state = atGuard state.memory ∧
    LoopFrame [] Memory.empty state.memory [.word32] [.bytes .word32 home]
      (knownLocals [some (.i32 1)])
  apply SegmentExit.diverges_of_recurrent (invariant := invariant) _ ⟨rfl, rfl, facts⟩
  rintro _ ⟨currentFrame, stack, current⟩ ⟨rfl, same, known⟩
  cases same
  obtain ⟨updated, wrote, next, -⟩ := known.store 0 (.i32 1) rfl
  refine ⟨7, atGuard updated, 6, by decide, SegmentRun.reaches ?_, rfl, rfl, next⟩
  intro fuel
  dsimp only [atGuard, frame, entry.frame]
  cil_checked_steps [known.load 0, wrote]
  change run Extracted.program (fuel + 1) 0 6 (countdownContract.args 1) frame [.scalar (.i32 1)]
      current =
    run Extracted.program fuel 0 7 (countdownContract.args 1) frame [] updated
  have last : step Extracted.method0 (.stloc 0) 6 (countdownContract.args 1) frame
      [.scalar (.i32 1)] current = .ok (.next 7 [] frame updated) := by
    change (do
      let (slot, memory) ← storeLocal current (.bytes .word32 home) (.scalar (.i32 1))
      pure (FrameAction.next 7 [] {frame with locals := [slot]} memory)) = _
    rw [show storeLocal current (.bytes .word32 home) (.scalar (.i32 1)) =
      .ok (.bytes .word32 home, updated) from wrote]
    rfl
  have placed : Extracted.method0.code[6]? = some (.stloc 0) := rfl
  simp only [run_succ, Extracted.program_method0, placed, last, Except.mapError,
    Bind.bind, Except.bind]
