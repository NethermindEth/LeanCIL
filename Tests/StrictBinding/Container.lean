import StrictBinding.Dump
import Tests.StrictBinding.Fixture
import Tests.StrictBinding.Mutation

/-!
# Strict binding tests: container and tables

The decoding of the fixture's PE container, `#~` header and table positions must equal what
System.Reflection.Metadata reads from the same bytes (`StrictFixture.expectedFacts`, generated by
`Tests/StrictBindingFixture.cs`). Each rejection then changes one byte or one section of a file
that decodes and asserts the exact error: a decoder that skipped a check would accept the changed
file or report another error.
-/

namespace Tests.StrictBinding.Container

open _root_.StrictBinding

/-- The fixture decodes to exactly the facts an independent reader finds in its bytes. -/
theorem decodes_as_system_reflection_metadata_reads_it :
    ((facts StrictFixture.image).toOption == some StrictFixture.expectedFacts) = true := by
  decide +kernel
#print axioms decodes_as_system_reflection_metadata_reads_it

/-- The error decoding the container and tables of an image gives, when it fails. -/
private def decodeError (image : ImageBytes) : Option AuditError :=
  match ImageView.ofImage image >>= decodeMetadata with
  | .error error => some error
  | .ok _ => none

/-- The unchanged fixture has a container; the offsets below describe it. -/
theorem fixture_container_decodes : decodeError StrictFixture.image = none := by decide +kernel
#print axioms fixture_container_decodes

theorem rejects_a_missing_dos_signature :
    decodeError (flipByte StrictFixture.image 0 0xFF) = some (.pe .notDos) := by decide +kernel
#print axioms rejects_a_missing_dos_signature

/-- The PE header of the SDK-built fixture starts at `0x80`. -/
theorem rejects_a_missing_pe_signature :
    decodeError (flipByte StrictFixture.image 0x80 0xFF) = some (.pe (.badSignature 0x80)) := by
  decide +kernel
#print axioms rejects_a_missing_pe_signature

/-- The optional header magic `0x10B` becomes `0x1F4`. -/
theorem rejects_an_unknown_optional_header_magic :
    decodeError (flipByte StrictFixture.image (0x80 + 24) 0xFF) =
      some (.pe (.badMagic 0x1F4)) := by
  decide +kernel
#print axioms rejects_an_unknown_optional_header_magic

/-- The fixture's metadata root is at offset 684. -/
theorem rejects_a_missing_metadata_signature :
    decodeError (flipByte StrictFixture.image 684 0xFF) = some (.pe .badMetadataRoot) := by
  decide +kernel
#print axioms rejects_a_missing_metadata_signature

/-- The fixture's `#~` stream is at offset 792; its heap size flags are the seventh byte. -/
theorem rejects_unknown_heap_size_flags :
    decodeError (flipByte StrictFixture.image (792 + 6) 0x08) =
      some (.tables (.unsupportedHeapSizes 8)) := by
  decide +kernel
#print axioms rejects_unknown_heap_size_flags

/-- A `Valid` bit above table `0x2C` has no schema, so row sizes cannot be computed. -/
theorem rejects_a_table_above_the_schema :
    (match decodeError (flipByte StrictFixture.image (792 + 8 + 5) 0x20) with
      | some (.tables (.unsupportedTables _)) => true
      | _ => false) = true := by
  decide +kernel
#print axioms rejects_a_table_above_the_schema

/-- A pointer table (FieldPtr, bit 3) has other tables index it, so it is refused by name. -/
theorem rejects_a_pointer_table :
    (match decodeError (flipByte StrictFixture.image (792 + 8) 0x08) with
      | some (.tables (.pointerTables _)) => true
      | _ => false) = true := by
  decide +kernel
#print axioms rejects_a_pointer_table

/-- A Module row count of 65 puts the tables past the end of the stream. -/
theorem rejects_row_counts_past_the_stream :
    decodeError (flipByte StrictFixture.image (792 + 24) 0x40) =
      some (.tables .badTableStream) := by
  decide +kernel
#print axioms rejects_row_counts_past_the_stream

/-! ## Tokens -/

/-- The layout of the unchanged fixture. -/
private def fixtureLayout : Except AuditError (ImageView × MetadataLayout) := do
  let view ← ImageView.ofImage StrictFixture.image
  pure (view, ← decodeMetadata view)

/-- The offset of the first MethodDef row, then the row size, from the fixture's facts: the table
    starts at 1116 and its rows are 14 bytes. -/
theorem method_rows_are_positioned_by_token :
    (fixtureLayout.bind fun (_, layout) => layout.rowAt (tokenOf 0x06 1)).toOption =
      some (1116, 14) ∧
    (fixtureLayout.bind fun (_, layout) => layout.rowAt (tokenOf 0x06 10)).toOption =
      some (1116 + 9 * 14, 14) := by
  decide +kernel
#print axioms method_rows_are_positioned_by_token

/-- Row zero and the row after the last are outside the table. -/
theorem rejects_tokens_outside_their_table :
    failsWith (fixtureLayout.bind fun (_, layout) => layout.rowAt (tokenOf 0x06 0))
      (.tokenOutOfScope (tokenOf 0x06 0)) = true ∧
    failsWith (fixtureLayout.bind fun (_, layout) => layout.rowAt (tokenOf 0x06 11))
      (.tokenOutOfScope (tokenOf 0x06 11)) = true := by
  decide +kernel
#print axioms rejects_tokens_outside_their_table

/-- A table the file does not have contains no token. -/
theorem rejects_tokens_of_an_absent_table :
    failsWith (fixtureLayout.bind fun (_, layout) => layout.rowAt (tokenOf 0x2A 1))
      (.tokenOutOfScope (tokenOf 0x2A 1)) = true := by
  decide +kernel
#print axioms rejects_tokens_of_an_absent_table

/-- A column past the schema of its table does not exist. -/
theorem rejects_a_column_past_the_schema :
    failsWith (fixtureLayout.bind fun (_, layout) => layout.cellAt (tokenOf 0x06 1) 6)
      (.tables (.noSuchColumn 0x06 6)) = true := by
  decide +kernel
#print axioms rejects_a_column_past_the_schema

/-! ## Relative virtual addresses -/

/-- A text section of `0x1000` bytes at `0x2000`, from file offset `0x200`. -/
private def text : Section :=
  { virtualSize := 0x1000, virtualAddress := 0x2000, rawSize := 0x1000, rawPointer := 0x200 }

/-- A section that follows it. -/
private def data : Section :=
  { virtualSize := 0x400, virtualAddress := 0x3000, rawSize := 0x200, rawPointer := 0x1200 }

theorem maps_an_address_into_its_section :
    (mapRva [text, data] 0x2010 4).toOption = some 0x210 ∧
    (mapRva [text, data] 0x3004 4).toOption = some 0x1204 := by
  decide +kernel
#print axioms maps_an_address_into_its_section

/-- No section holds an address before the first one or after the last. -/
theorem rejects_an_unmapped_address :
    failsWith (mapRva [text, data] 0x1FFF 1) (.pe (.unmappedRva 0x1FFF 1)) = true ∧
    failsWith (mapRva [text, data] 0x3400 1) (.pe (.unmappedRva 0x3400 1)) = true := by
  decide +kernel
#print axioms rejects_an_unmapped_address

/-- Bytes that leave the section's raw data are unmapped, even inside its mapped size. -/
theorem rejects_bytes_past_the_raw_data :
    failsWith (mapRva [text, data] 0x31FC 8) (.pe (.unmappedRva 0x31FC 8)) = true ∧
    (mapRva [text, data] 0x31FC 4).toOption = some 0x13FC := by
  decide +kernel
#print axioms rejects_bytes_past_the_raw_data

/-- Bytes that leave the mapped size are unmapped, even inside the raw data. -/
theorem rejects_bytes_past_the_mapped_size :
    failsWith (mapRva [{ text with virtualSize := 0x100 }] 0x20FC 8)
      (.pe (.unmappedRva 0x20FC 8)) = true := by
  decide +kernel
#print axioms rejects_bytes_past_the_mapped_size

/-- An address inside two sections has no single file position. -/
theorem rejects_an_address_in_two_sections :
    failsWith (mapRva [text, { data with virtualAddress := 0x2800 }] 0x2900 1)
      (.pe (.ambiguousRva 0x2900)) = true := by
  decide +kernel
#print axioms rejects_an_address_in_two_sections

/-! ## Heap entries and identity -/

/-- The fixture identity with selected Assembly flags and key bytes in its blob heap. -/
private def identityWithKey (flags : Nat) (key : List Nat) :
    Except AuditError (List Nat) := do
  let (view, layout) ← fixtureLayout
  let (flagsOffset, _) ← layout.cellAt (tokenOf 0x20 1) 5
  let (keyOffset, keyWidth) ← layout.cellAt (tokenOf 0x20 1) 6
  let bytes ← view.bytes 0 StrictFixture.image.length
  let bytes := (List.range 4).foldl
    (fun bytes index => bytes.set (flagsOffset + index) (flags / 256 ^ index % 256)) bytes
  let bytes := (List.range keyWidth).foldl
    (fun bytes index => bytes.set (keyOffset + index) 0) bytes
  let blob := key.length :: key
  let changed ← ImageView.ofImage (ImageBytes.ofBytes (bytes ++ blob))
  let pe := { layout.pe with blobs := { start := bytes.length, size := blob.length } }
  assemblyIdentity changed { layout with pe := pe }

/-- An unflagged eight-byte key is already a token, in display byte order. -/
theorem assembly_uses_unflagged_token :
    (identityWithKey 0 [0, 0xab, 0, 0, 0, 0, 0, 0xcd]).toOption =
      some (asciiOf
        "StrictFixture, Version=1.2.3.4, Culture=neutral, PublicKeyToken=00ab0000000000cd") := by
  decide +kernel
#print axioms assembly_uses_unflagged_token

/-- Empty key blobs have no token with either PublicKey flag value. -/
theorem assembly_empty_key_has_no_token :
    (identityWithKey 0 []).toOption = some (asciiOf
      "StrictFixture, Version=1.2.3.4, Culture=neutral, PublicKeyToken=null") ∧
    (identityWithKey 1 []).toOption = (identityWithKey 0 []).toOption := by
  decide +kernel
#print axioms assembly_empty_key_has_no_token

/-- A flagged full key uses the reversed low eight SHA-1 digest bytes. -/
theorem assembly_hashes_flagged_key :
    (identityWithKey 1 (asciiOf "abc")).toOption = some (asciiOf
      "StrictFixture, Version=1.2.3.4, Culture=neutral, PublicKeyToken=9dd8d09c6cc25078") := by
  decide +kernel
#print axioms assembly_hashes_flagged_key

/-- Flags other than PublicKey preserve both key interpretations. -/
theorem assembly_ignores_other_key_flags :
    (identityWithKey 0x8100 [0, 0xab, 0, 0, 0, 0, 0, 0xcd]).toOption =
      (identityWithKey 0 [0, 0xab, 0, 0, 0, 0, 0, 0xcd]).toOption ∧
    (identityWithKey 0x8101 (asciiOf "abc")).toOption =
      (identityWithKey 1 (asciiOf "abc")).toOption := by
  decide +kernel
#print axioms assembly_ignores_other_key_flags

/-- Nonempty unflagged blobs must have exactly eight bytes. -/
theorem assembly_rejects_invalid_token_widths :
    failsWith (identityWithKey 0 [1]) (.tables (.invalidPublicKeyToken 1)) = true ∧
    failsWith (identityWithKey 0 (List.replicate 7 0))
      (.tables (.invalidPublicKeyToken 7)) = true ∧
    failsWith (identityWithKey 0 (List.replicate 9 0))
      (.tables (.invalidPublicKeyToken 9)) = true := by
  decide +kernel
#print axioms assembly_rejects_invalid_token_widths

/-- An eight-byte zero token remains distinct from an absent token. -/
theorem assembly_preserves_zero_token :
    (identityWithKey 0 (List.replicate 8 0)).toOption = some (asciiOf
      "StrictFixture, Version=1.2.3.4, Culture=neutral, PublicKeyToken=0000000000000000") := by
  decide +kernel
#print axioms assembly_preserves_zero_token

theorem spells_version_components :
    decimal 0 = asciiOf "0" ∧ decimal 7 = asciiOf "7" ∧ decimal 10 = asciiOf "10" ∧
    decimal 65535 = asciiOf "65535" := by
  decide +kernel
#print axioms spells_version_components

theorem spells_a_key_token_with_leading_zeros :
    hexDigits 16 0x00ab0000000000cd = asciiOf "00ab0000000000cd" := by decide +kernel
#print axioms spells_a_key_token_with_leading_zeros

/-- UTF-8 of one to four bytes decodes to code points. -/
theorem decodes_utf8 :
    utf8CodePoints 8 [0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80] =
      some [0x61, 0xE9, 0x20AC, 0x1F600] := by
  decide +kernel
#print axioms decodes_utf8

/-- An overlong form, a lone continuation byte, a surrogate and a truncated sequence are not
    UTF-8. -/
theorem rejects_malformed_utf8 :
    utf8CodePoints 4 [0xC0, 0x80] = none ∧ utf8CodePoints 4 [0x80] = none ∧
    utf8CodePoints 4 [0xED, 0xA0, 0x80] = none ∧ utf8CodePoints 4 [0xE2, 0x82] = none := by
  decide +kernel
#print axioms rejects_malformed_utf8

end Tests.StrictBinding.Container
